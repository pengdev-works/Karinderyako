# Environment Variables — KarinderyaKo Backend
# Copy this file to .env and fill in your values

# Neon PostgreSQL Connection String
# Get this from: console.neon.tech → Your Project → Connect → Connection String
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Server Port (Render sets this automatically)
PORT=5050

# Frontend URL for CORS (your Vercel URL after deployment)
# During development: http://localhost:3001
# After Vercel deploy: https://your-app-name.vercel.app
FRONTEND_URL=http://localhost:3001

# Node Environment
NODE_ENV=development
